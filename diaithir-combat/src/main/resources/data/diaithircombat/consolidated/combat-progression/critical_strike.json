 "events": [
  {
   "id": "crit_roll",
   "trigger": "server melee hit resolved (after parry check, after combo multiplier)",
   "effect": "roll once per primary target against clamp(base 0.05 + sum crit_chance modifiers, 0, 0.75); on success damage *= clamp(1.5 + sum crit_damage modifiers, 1.0, 3.0); fall crit and crit combine as max, not product, unless crit.stack_with_fall is true"
  },
  {
   "id": "crit_feedback",
   "trigger": "crit_roll succeeded",
   "effect": "send crit_result packet to tracking clients; client spawns crit particles and plays hit_crit sound; no client-side roll"
  },
  {
   "id": "crit_parried_cancel",
   "trigger": "komrag parry succeeds",
   "effect": "hit cancelled before crit_roll; no roll, no feedback"
  },
  {
   "id": "crit_sweep_secondary",
   "trigger": "sweep hits secondary targets",
   "effect": "each secondary target rolls separately when crit.sweep_rolls is true, else only primary rolls"
  }
 ],
