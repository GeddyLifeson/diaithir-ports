{
  "type": "create:sequenced_assembly",
  "ingredient": "create_new_age:radioactive_thorium",
  "transitional_item": {
    "id": "create_new_age:incomplete_fuel"
  },
  "result": {
    "id": "create_new_age:nuclear_fuel"
  },
  "loops": 1,
  "sequence": [
    {
      "type": "create:pressing",
      "ingredient": "$ingredient",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "#c:plates/iron",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:pressing",
      "ingredient": "$ingredient",
      "results": [
        "$result"
      ]
    }
  ]
}
