{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "version": "${mod_version}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "${mod_repo_url}",
    "issues": "${mod_repo_url}/issues"
  },
  "description": "${mod_description}",
  "icon": "${mod_logo}",
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.iafenvoy.jupiter._loader.fabric.JupiterFabric"
    ],
    "client": [
      "com.iafenvoy.jupiter._loader.fabric.JupiterFabricClient"
    ],
    "modmenu": [
      "com.iafenvoy.jupiter._loader.fabric.compat.ModMenu"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version_range_fabric}",
    "fabric-api": "*"
  }
}