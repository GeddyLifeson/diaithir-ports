{
 "multipart": [
  {
   "apply": {
    "model": "diaithircreatureutils:block/oak_plank_fence_post"
   }
  },
  {
   "when": {
    "north": "true"
   },
   "apply": {
    "model": "diaithircreatureutils:block/oak_plank_fence_side",
    "uvlock": true
   }
  },
  {
   "when": {
    "east": "true"
   },
   "apply": {
    "model": "diaithircreatureutils:block/oak_plank_fence_side",
    "uvlock": true,
    "y": 90
   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "diaithircreatureutils:block/oak_plank_fence_side",
    "uvlock": true,
    "y": 180
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "diaithircreatureutils:block/oak_plank_fence_side",
    "uvlock": true,
    "y": 270
   }
  }
 ]
}
