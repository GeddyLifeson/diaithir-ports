 "events": [
  {
   "id": "diaithirnights:night_siege",
   "trigger": "world_night_counter % cadence_nights == 0 (default 7) in an enabled dimension; dusk at tick 13000",
   "effect": "Sky darkens, bell cue and title line play, 3 to 5 waves spawn in a 24-40 m ring around players until dawn at tick 23000 or final wave cleared"
  },
  {
   "id": "diaithirnights:wave_spawn",
   "trigger": "previous wave cleared or dusk start",
   "effect": "Spawn count = min(60 alive, 8 + 4*(wave-1) + 2*(extra_players_in_range)); mobs picked from the diaithir-arms Age roster; ring 24-40 m from target, at least 12 m from other players, ignoring light-level rules"
  },
  {
   "id": "diaithirnights:final_wave_elite",
   "trigger": "final wave begins",
   "effect": "Spawns one Night Elite (max 1); title line announces it; siege_trophy drops on death"
  },
  {
   "id": "diaithirnights:horde_pathing",
   "trigger": "siege mob spawned",
   "effect": "Pathfinds to nearest player or claimed base marker; Ward Banner within 16 m overrides target as a decoy"
  },
  {
   "id": "diaithirnights:block_breaking",
   "trigger": "siege mob blocked on path by a non-blacklisted soft block",
   "effect": "Per-hit timer 40 ticks scaled by block hardness; blocks in tag diaithirnights:siege_immune (stone and above) are never broken"
  },
  {
   "id": "diaithirnights:dawn_cleanup",
   "trigger": "world time reaches tick 23000 or siege cleared",
   "effect": "Siege mobs despawn or ignite; daylight immunity ends; boss bar removed"
  },
  {
   "id": "diaithirnights:wave_reward",
   "trigger": "wave cleared",
   "effect": "Roll data loot table diaithirnights:rewards/wave_age_<n>; no-death clear adds a bonus roll"
  },
  {
   "id": "diaithirnights:rally_horn_use",
   "trigger": "player uses Rally Horn",
   "effect": "Starts a siege at next tick if none active; 24000-tick cooldown applied; blocked in disabled dimensions"
  },
  {
   "id": "diaithirnights:brazier_suppression",
   "trigger": "siege spawn attempt within 8 m of a lit Ember Brazier",
   "effect": "Spawn cancelled and retried elsewhere in the ring"
  },
  {
   "id": "diaithirnights:age_scaling",
   "trigger": "mob spawned during siege",
   "effect": "Reads scoreboard age (1-9); health +10% per Age, damage +5% per Age; wave size scaled by speedPerAge-style config key"
  }
