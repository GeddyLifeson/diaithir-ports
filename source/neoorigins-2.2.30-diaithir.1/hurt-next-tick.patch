+    /**
+     * Diaithir patch: reflect damage must not kill an entity while this handler runs, because the attacker can itself be
+     * inside its own LivingDamageEvent.Pre (a wrapped spell hit); NeoForge then throws "It is invalid to have killed an
+     * entity during LivingDamageEvent.Pre". The hurt is applied on the owner's next tick instead.
+     */
+    public static void hurtNextTick(net.minecraft.server.level.ServerPlayer owner, LivingEntity target,
+                                    net.minecraft.world.damagesource.DamageSource src, float amount) {
+        var server = owner.level().getServer();
+        if (server == null) { target.hurt(src, amount); return; }
+        com.cyberday1.neoorigins.compat.CompatTickScheduler.schedule(server.getTickCount() + 1, owner, p -> {
+            if (target.isAlive()) target.hurt(src, amount);
+        });
+    }
