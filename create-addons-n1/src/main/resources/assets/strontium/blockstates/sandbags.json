{
  "multipart": [
    {
      "apply": { "model": "strontium:block/sandbags_center" }
    },
    {
      "when": { "north": true },
      "apply": { "model": "strontium:block/sandbags_side", "uvlock": true }
    },
    {
      "when": { "east": true },
      "apply": { "model": "strontium:block/sandbags_side", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": true },
      "apply": { "model": "strontium:block/sandbags_side", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": true },
      "apply": { "model": "strontium:block/sandbags_side", "y": 270, "uvlock": true }
    },
    {
      "when": { "corner_ne": true },
      "apply": { "model": "strontium:block/sandbags_corner", "uvlock": true }
    },
    {
      "when": { "corner_es": true },
      "apply": { "model": "strontium:block/sandbags_corner", "y": 90, "uvlock": true }
    },
    {
      "when": { "corner_sw": true },
      "apply": { "model": "strontium:block/sandbags_corner", "y": 180, "uvlock": true }
    },
    {
      "when": { "corner_wn": true },
      "apply": { "model": "strontium:block/sandbags_corner", "y": 270, "uvlock": true }
    }
  ]
}